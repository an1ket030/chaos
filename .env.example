# ============================================================
# Chaos Club Auction — Environment Variables
# Copy this file to .env (never commit .env!)
# ============================================================

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Database (PostgreSQL) ---
# Docker Compose default:
DATABASE_URL=postgresql://chaosclub:chaosclub_dev_password@localhost:5432/chaosclub

# --- Cache (Redis) ---
# Docker Compose default:
REDIS_URL=redis://localhost:6379

# --- JWT ---
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here_minimum_64_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_minimum_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# --- Frontend ---
CLIENT_URL=http://localhost:5173

# --- Player Data ---
# Football-Data.org API key (optional, for live data)
FOOTBALL_DATA_API_KEY=

# --- Session ---
SESSION_SECRET=your_session_secret_here
